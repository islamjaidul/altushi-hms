@using Hms.Kernel.Entitlements
@using Hms.Kernel.Time
@inject IReadOnlyList<NavItem> NavRegistry
@inject EntitlementProvider Entitlements
@inject BusinessDayCalendar BusinessDay
@inject TimeProvider Clock
@{
    var user = Context.User;
    var isAuthed = user.Identity?.IsAuthenticated == true;
    var perms = user.FindAll(PermissionPolicy.ClaimType).Select(c => c.Value).ToHashSet();
    var nav = isAuthed
        ? NavComposer.Compose(NavRegistry, perms, Entitlements.EnabledModules.ToHashSet())
        : [];
    var displayName = user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? "";
    var roles = string.Join(", ", user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
    var businessDay = BusinessDay.BusinessDayOf(Clock.GetUtcNow());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "HMS") — Altushi HMS</title>
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div class="shell">
    @if (isAuthed)
    {
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">AH</span>
                <span class="brand-name">Altushi HMS</span>
            </div>
            <nav aria-label="Modules">
                @foreach (var group in nav)
                {
                    <div class="nav-group">
                        <div class="nav-group-title">
                            <span class="dept-dot" data-dept="@group.Module.ToLowerInvariant()"></span>
                            @group.Module
                        </div>
                        @foreach (var item in group.Items)
                        {
                            <a class="nav-item" href="@item.Url">@item.Title</a>
                        }
                    </div>
                }
            </nav>
        </aside>
    }
    <div class="main">
        @if (isAuthed)
        {
            <header class="topbar">
                <div class="breadcrumb">@(ViewData["Title"] ?? "Home")</div>
                <div class="topbar-right">
                    <span class="user-chip">@displayName <span class="user-role">@roles</span></span>
                    <form method="post" action="/logout" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-quiet">Sign out</button>
                    </form>
                </div>
            </header>
        }
        <main class="content">
            @RenderBody()
        </main>
        <footer class="status-footer">
            <span class="status-ok">● Server OK</span>
            @if (isAuthed)
            {
                <span>@displayName (@roles)</span>
                <span>Business day: @businessDay.ToString("dd MMM yyyy")</span>
                <span id="fkey-map" class="fkey-map"></span>
            }
        </footer>
    </div>
</div>
<script src="/js/fkeys.js"></script>
<script src="/js/typeahead.js"></script>
<script src="/js/barcode.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
