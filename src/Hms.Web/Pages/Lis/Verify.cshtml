@page "/lis/verify"
@model Hms.Web.Pages.Lis.VerifyModel
@{
    ViewData["Title"] = "Verification Queue";
    ViewData["Crumb"] = "Laboratory";
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert bad">
        <span class="icon icon-sm" aria-hidden="true">error</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<div class="grid grid-side-main">
    <div class="card card-clip">
        <div class="card-head">
            Awaiting verification
            <span class="spacer"></span>
            <span class="card-hint">@Model.Worklist.Count</span>
        </div>
        @foreach (var c in Model.Worklist)
        {
            var selected = Model.Selected?.OrderId == c.OrderId;
            <a class="worklist-row @(selected ? "selected" : "")" href="/lis/verify?orderId=@c.OrderId">
                <div class="worklist-id">
                    @c.OrderNo
                    @* US9.3: the queue itself says where to look first (spec 0044). *@
                    @if (c.HasCritical)
                    {
                        <span class="pill bad" style="padding:1px 6px">CRITICAL</span>
                    }
                </div>
                <div style="font-size:0.78125rem;font-weight:600">@c.PatientName</div>
                <div class="worklist-sub">@c.TestList</div>
            </a>
        }
        @if (Model.Worklist.Count == 0)
        {
            <div class="empty-state">
                <span class="icon" aria-hidden="true">task_alt</span>
                Nothing waiting for verification.
            </div>
        }
    </div>

    @if (Model.Selected is { } sel)
    {
        <form method="post" class="stack"
              data-confirm="Verify and release this report? Your e-signature is attached to these values, and the patient is notified immediately.">
            <input type="hidden" name="OrderId" value="@sel.OrderId" />

            <div class="patient-banner">
                <span class="avatar">@Ui.Initials(sel.PatientName)</span>
                <span>
                    <div class="patient-name">@sel.PatientName</div>
                    <div class="patient-meta">@sel.Uhid · @sel.OrderNo · @sel.TestList</div>
                </span>
                <span class="spacer"></span>
                @if (sel.Held)
                {
                    <span class="pill bad">Due @Ui.Money(sel.Due)</span>
                }
            </div>

            @* Spec 0044 / US9.3: criticals are lifted above the grid, because "focus attention
               where it matters" cannot mean "read every row of every test looking for red". *@
            @{ var criticals = Model.Criticals; }
            @if (criticals.Count > 0)
            {
                <div class="alert bad">
                    <span class="icon icon-sm" aria-hidden="true">priority_high</span>
                    <span>
                        <b>
                            @(criticals.Count == 1
                                ? "This report carries a critical value"
                                : $"This report carries {criticals.Count} critical values")
                        </b>
                        <ul style="margin:6px 0 10px 18px">
                            @foreach (var c in criticals)
                            {
                                <li><b>@c.Value.Name @c.Value.Value @c.Value.Unit</b>
                                    — @ResultFlags.Label(c.Value.Flag)
                                    <span class="text-muted">(@c.TestName · reference @c.Value.Range)</span>
                                </li>
                            }
                        </ul>
                        <label class="row" style="gap:8px;align-items:flex-start">
                            <input type="checkbox" asp-for="CriticalAcknowledged"
                                   style="width:18px;height:18px;margin-top:2px" />
                            <span>
                                <b>I have seen @(criticals.Count == 1 ? "this value" : "these values")
                                   and taken the action my lab's critical-value policy requires.</b>
                                <span class="help-text" style="display:block">
                                    Recorded against this report with your name and the time.
                                    The report cannot be released without it.
                                </span>
                            </span>
                        </label>
                    </span>
                </div>
            }

            @foreach (var t in Model.Tests)
            {
                <div class="card card-clip">
                    <div class="card-head">
                        @t.Name
                        <span class="spacer"></span>
                        <span class="card-hint">
                            entered by @(t.EnteredBy ?? "—") · @Ui.DateTimeShort(t.EnteredAt)
                        </span>
                        @if (t.Verified)
                        {
                            <span class="pill good">Verified</span>
                        }
                    </div>

                    @if (t.Values.Count > 0)
                    {
                        <div class="table-wrap">
                            <table class="data">
                                <thead>
                                <tr>
                                    <th>Parameter</th>
                                    <th class="num">Result</th>
                                    <th class="mid" style="width:70px">Flag</th>
                                    <th style="width:100px">Unit</th>
                                    <th style="width:130px">Reference</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var v in t.Values)
                                {
                                    <tr>
                                        <td>@v.Name</td>
                                        <td class="num"><b>@v.Value</b></td>
                                        <td class="mid">
                                            @if (ResultFlags.IsCritical(v.Flag))
                                            {
                                                <span class="pill bad">@ResultFlags.Short(v.Flag)</span>
                                            }
                                            else if (v.Flag == ResultFlags.High)
                                            {
                                                <span class="flag high">High</span>
                                            }
                                            else if (v.Flag == ResultFlags.Low)
                                            {
                                                <span class="flag low">Low</span>
                                            }
                                            else
                                            {
                                                <span class="flag none">—</span>
                                            }
                                        </td>
                                        <td class="text-muted">@v.Unit</td>
                                        <td class="text-muted tabular">@v.Range</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.Narrative))
                    {
                        <div class="card-body" style="padding-top:0">@t.Narrative</div>
                    }
                </div>
            }

            <div class="row">
                <span class="card-hint">
                    Verifying attaches your e-signature to exactly these values and releases the
                    report. A correction afterwards creates a new version — it never rewrites this one.
                </span>
                <span class="spacer"></span>
                <label class="field" style="width:300px;margin-right:10px">
                    <span class="field-label">Signed by <span class="req">*</span></span>
                    <select class="select" asp-for="ConsultantId">
                        @foreach (var c in Model.Consultants)
                        {
                            <option value="@c.Id">@c.Label</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn btn-success btn-cta">
                    <span class="icon icon-sm" aria-hidden="true">verified</span> Verify &amp; e-sign
                </button>
            </div>
        </form>
    }
    else
    {
        <div class="empty-card">
            <span class="icon" aria-hidden="true">verified</span>
            Select an order on the left to review and sign it.
        </div>
    }
</div>
