@page "/registration/{id:long}/edit"
@model Hms.Web.Pages.Registration.EditModel
@{
    ViewData["Title"] = Model.WasUnknown ? "Complete Patient Identity" : "Correct Patient Details";
    ViewData["Crumb"] = "Front Desk";
    ViewData["FKeys"] = "Enter advances · Tab to move · Alt+S saves";
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert bad">
        <span class="icon icon-sm" aria-hidden="true">error</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

@if (Model.WasUnknown)
{
    <div class="alert info">
        <span class="icon icon-sm" aria-hidden="true">info</span>
        <span>
            <b>This patient was registered as unknown</b> — an emergency case, admitted before
            anyone could say who he was. Filling the name in here keeps the same
            <b>@Model.Uhid</b>: the same record, the same history, the same admission.
            Never register him a second time.
        </span>
    </div>
}

@{
    var likely = Model.LikelyDuplicates.ToList();
    var sharedPhone = Model.SharedPhone.ToList();
}

@if (likely.Count > 0)
{
    <div class="alert warn">
        <span class="icon icon-sm" aria-hidden="true">warning</span>
        <span>
            <b>@likely.Count possible duplicate@(likely.Count == 1 ? "" : "s")</b> —
            this name is already on another record. If it is the same person, these two records
            need merging rather than one of them renamed. Continue below only if they are
            different people.
            <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px">
                @foreach (var d in likely)
                {
                    <a class="btn-tint" href="/registration?q=@d.Uhid">
                        @d.FullName · @d.Uhid ·
                        @Ui.SexWord(d.Sex)@(d.AgeYears is { } y ? ", " + y : "")
                    </a>
                }
            </div>
        </span>
    </div>
}

@if (sharedPhone.Count > 0)
{
    <div class="alert info">
        <span class="icon icon-sm" aria-hidden="true">info</span>
        <span>
            <b>Someone else already uses this number</b> — family members often share one mobile.
            Continue below if this is a different person.
            <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px">
                @foreach (var d in sharedPhone)
                {
                    <a class="btn-tint" href="/registration?q=@d.Uhid">
                        @d.FullName · @d.Uhid ·
                        @Ui.SexWord(d.Sex)@(d.AgeYears is { } y2 ? ", " + y2 : "")
                    </a>
                }
            </div>
        </span>
    </div>
}

<form method="post" class="grid grid-main-side">
    <div class="card">
        <div class="card-head">
            @(Model.WasUnknown ? "Complete this patient's identity" : "Correct these details")
            <span class="spacer"></span>
            <span class="card-hint">Fields marked <span class="req">*</span> are required</span>
        </div>

        <div class="field-grid cols-3" style="padding:4px 20px 16px">
            <div class="field">
                <span class="field-label">Hospital ID</span>
                @* Never an input: this is the identity every other module refers to. *@
                <input class="input" value="@Model.Uhid" disabled />
                <span class="help-text">Permanent — it cannot be changed.</span>
            </div>
            <label class="field span-2">
                <span class="field-label">Full name <span class="req">*</span></span>
                <input class="input" asp-for="FullName" data-advance autofocus
                       placeholder="Patient's full name" autocomplete="off" />
            </label>

            <label class="field">
                <span class="field-label">Age or date of birth <span class="req">*</span></span>
                <input class="input" asp-for="AgeOrDob" data-advance placeholder="45  ·  8 months  ·  12/03/1980" />
                <span class="help-text">Years, months or a date — all accepted.</span>
            </label>
            <label class="field">
                <span class="field-label">Sex <span class="req">*</span></span>
                <select class="select" asp-for="Sex" data-advance>
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                    <option value="O">Other</option>
                </select>
                <span class="help-text">Used to pick the lab's reference range — worth getting right.</span>
            </label>
            <label class="field">
                <span class="field-label">Mobile number</span>
                <input class="input" asp-for="Phone" data-advance placeholder="01XXX-XXXXXX" inputmode="numeric" />
            </label>

            <label class="field">
                <span class="field-label">Blood group</span>
                <select class="select" asp-for="BloodGroup" data-advance>
                    <option value="">Unknown</option>
                    @foreach (var g in new[] { "A+", "A−", "B+", "B−", "O+", "O−", "AB+", "AB−" })
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">Guardian / attendant</span>
                <input class="input" asp-for="Guardian" data-advance placeholder="Name (relation)" />
            </label>
            <label class="field">
                <span class="field-label">Area / Thana</span>
                <input class="input" asp-for="Area" data-advance placeholder="e.g. Zindabazar" />
            </label>

            <label class="field span-2">
                <span class="field-label">Known allergies</span>
                <input class="input" asp-for="Allergies" data-advance
                       placeholder="penicillin, NSAIDs… (leave blank if none stated)" />
            </label>
            <label class="field">
                <span class="field-label">Patient type</span>
                <select class="select" asp-for="PatientType" data-advance>
                    <option value="general">General</option>
                    <option value="corporate">Corporate</option>
                    <option value="package">Health package</option>
                    <option value="staff">Staff / family</option>
                </select>
            </label>

            <label class="field span-3">
                <span class="field-label">Full address</span>
                <input class="input" asp-for="Address" data-advance placeholder="House, road, post office…" />
            </label>
        </div>

        <div class="row" style="padding:0 20px 18px;gap:10px">
            <button type="submit" class="btn btn-primary btn-cta">
                <span class="icon icon-sm" aria-hidden="true">save</span>
                @(Model.WasUnknown ? "Save identity & print card" : "Save changes")
            </button>
            @if (likely.Count > 0 || sharedPhone.Count > 0)
            {
                <button type="submit" name="DuplicatesAcknowledged" value="true"
                        class="btn @(likely.Count > 0 ? "btn-danger" : "btn-primary")">
                    @(likely.Count > 0 ? "Not a duplicate — save anyway" : "Yes, a different person — save")
                </button>
            }
            <a class="btn" href="/registration/@Model.Id/card">Cancel</a>
            <span class="spacer"></span>
            <span class="card-hint">Every change is recorded with your name and the time.</span>
        </div>
    </div>

    <div class="stack">
        <div class="card card-body">
            <div class="card-head" style="padding:0 0 10px">What this does not change</div>
            <ul style="margin:0 0 0 18px;font-size:0.8125rem;line-height:1.7">
                <li>The <b>hospital ID</b> stays the same, for life.</li>
                <li>Every invoice, report and admission already issued keeps the name it was
                    issued under — history is never rewritten.</li>
                <li>Lab results already released keep the reference range they were judged
                    against, even if the sex or age changes here.</li>
            </ul>
        </div>
    </div>
</form>
