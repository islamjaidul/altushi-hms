@page "/registration/{id:long}/card"
@model Hms.Web.Pages.Registration.CardModel
@inject OrgIdentity Hospital
@{
    ViewData["Title"] = "Patient ID Card";
    ViewData["Crumb"] = "Front Desk";
}

<div style="display:flex;flex-direction:column;align-items:center;gap:12px">
    <div style="width:640px;max-width:100%">
        @await Html.PartialAsync("_PrintTools", "/registration?q=" + Model.Uhid)
        @* Spec 0045 (US1.4): where the operator is standing when the family arrives with a
           name — the card is printed, and the details on it are wrong or missing. *@
        <div class="row no-print" style="justify-content:flex-end;margin-top:8px">
            <a class="btn" href="/registration/@Model.Id/edit">
                <span class="icon icon-sm" aria-hidden="true">edit_note</span> Correct these details
            </a>
        </div>
    </div>

    <div class="sheet">
        @await Html.PartialAsync("_Letterhead",
            new Letterhead(Model.Reissue ? "Patient ID Card (re-issue)" : "Patient ID Card",
                Model.Uhid, Model.RegisteredAt))

        <div class="sheet-info">
            <div><span class="k">Patient:</span> <b>@Model.FullName</b></div>
            <div><span class="k">Registration no:</span> <b>@Model.Uhid</b></div>
            <div><span class="k">Age / Sex:</span> @Model.Age · @Ui.SexWord(Model.Sex)</div>
            <div><span class="k">Blood group:</span> @(Model.BloodGroup ?? "Not recorded")</div>
            <div><span class="k">Mobile:</span> @(Model.Phone ?? "Not recorded")</div>
            <div><span class="k">Registered:</span> @Ui.DateTimeShort(Model.RegisteredAt)</div>
            <div style="grid-column:span 2"><span class="k">Address:</span> @(Model.Address ?? "—")</div>
        </div>

        @* Spec 0039 WP6 (AUD-M1-01): a real Code 128 symbol encoding the UHID — a wedge scanner
           types it into any search box, which is what "scanning opens your record" promises. *@
        <div class="barcode">@Html.Raw(Barcode128.Svg(Model.Uhid))</div>
        <div class="barcode-text">@Model.Uhid</div>

        <div class="sheet-words" style="text-align:center;color:var(--muted-1)">
            Please bring this card on every visit. Scanning it opens your record instantly.
        </div>

        @await Html.PartialAsync("_SheetFooter")
    </div>
</div>
