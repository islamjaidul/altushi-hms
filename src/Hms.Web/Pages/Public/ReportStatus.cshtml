@page "/public/report-status"
@model Hms.Web.Pages.Public.ReportStatusModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Report Status</title>
    <link rel="stylesheet" href="/_content/Hms.Shell/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/Hms.Shell/css/app.css" asp-append-version="true" />
    <style>body { padding: 24px; max-width: 560px; margin: 0 auto; }</style>
</head>
<body>
    <h1 style="font-size:1.6rem;margin-bottom:14px">Is my report ready?</h1>

    <form method="get" class="card">
        <div class="card-body stack" style="gap:10px">
            <label class="field">
                <span class="field-label">Report code printed on your test slip</span>
                <input class="input" name="orderNo" value="@Model.Code" autofocus
                       placeholder="Report code from the slip" />
            </label>
            <button type="submit" class="btn btn-primary">Check status</button>
        </div>
    </form>

    @if (Model.NoMatch)
    {
        <div class="alert" style="margin-top:14px">
            <span>No report found for that code — please check the test slip or ask at the counter.</span>
        </div>
    }
    else if (Model.Status is not null)
    {
        <div class="card" style="margin-top:14px">
            <div class="card-head">Report status — @Model.MaskedName</div>
            <div class="card-body stack" style="gap:8px;padding-top:0">
                <div class="row" style="gap:10px">
                    <span>Your order</span>
                    <span class="spacer"></span>
                    <span class="pill @(Model.Status == "In progress" ? "warn" : "good")">@Model.Status</span>
                </div>
                <div class="card-hint">
                    Ready reports are collected at the delivery counter with your receipt.
                </div>
            </div>
        </div>
    }
</body>
</html>
