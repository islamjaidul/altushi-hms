@page "/login"
@model Hms.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — Altushi HMS</title>
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div class="login-wrap">
    <form method="post" class="login-card">
        <h1>Altushi HMS — Sign in</h1>
        @if (Model.Failed)
        {
            <p class="error-note">Sign-in failed — check the username and password.</p>
        }
        @if (Model.LockedOut)
        {
            <p class="error-note">Account locked after repeated failures — try again in a few minutes.</p>
        }
        <label class="field">
            <span class="field-label">Username</span>
            <input class="field-input" asp-for="Username" autofocus autocomplete="username" />
        </label>
        <label class="field">
            <span class="field-label">Password</span>
            <input class="field-input" asp-for="Password" type="password" autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
    </form>
</div>
</body>
</html>
