<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hms.Kernel\Hms.Kernel.csproj" />
    <ProjectReference Include="..\Hms.Shell\Hms.Shell.csproj" />
    <ProjectReference Include="..\Modules\Registration\Hms.Registration\Hms.Registration.csproj" />
    <ProjectReference Include="..\Modules\Appointments\Hms.Appointments\Hms.Appointments.csproj" />
    <ProjectReference Include="..\Modules\Billing\Hms.Billing\Hms.Billing.csproj" />
    <ProjectReference Include="..\Modules\Diagnostics\Hms.Diagnostics\Hms.Diagnostics.csproj" />
    <ProjectReference Include="..\Modules\Lis\Hms.Lis\Hms.Lis.csproj" />
    <ProjectReference Include="..\Modules\Dashboard\Hms.Dashboard\Hms.Dashboard.csproj" />
    <ProjectReference Include="..\Modules\Admin\Hms.Admin\Hms.Admin.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Hms.Notifications\Hms.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Pharmacy\Hms.Pharmacy\Hms.Pharmacy.csproj" />
    <ProjectReference Include="..\Modules\Emr\Hms.Emr\Hms.Emr.csproj" />
    <ProjectReference Include="..\Modules\Ot\Hms.Ot\Hms.Ot.csproj" />
    <ProjectReference Include="..\Modules\Radiology\Hms.Radiology\Hms.Radiology.csproj" />
    <ProjectReference Include="..\Modules\Ipd\Hms.Ipd\Hms.Ipd.csproj" />
    <ProjectReference Include="..\Modules\Hr\Hms.Hr\Hms.Hr.csproj" />
    <ProjectReference Include="..\Modules\Hr\Hms.Hr.Screens\Hms.Hr.Screens.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shell (layout, Ui formatters, HmsPageModel, OrgIdentity) moved to Hms.Shell so a second
         host can render into it (ADR-0025). Importing it globally keeps the 76 existing page models
         unchanged. -->
    <Using Include="Hms.Shell" />
  </ItemGroup>

  <ItemGroup>
    <!-- vendor entitlement public key must ship in the published image (ADR-0016) -->
    <Content Include="vendor-public-key.pem" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
