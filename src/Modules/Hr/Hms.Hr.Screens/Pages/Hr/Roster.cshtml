@page "/hr/roster"
@model Hms.Hr.Screens.Pages.Hr.RosterModel
@{
    ViewData["Title"] = "Roster";
    ViewData["Crumb"] = HrNav.Group;
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert bad">
        <span class="icon icon-sm" aria-hidden="true">error</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<div class="card card-clip">
    <div class="card-head">
        <h2>Week of @Ui.DateLong(Model.WeekStart)</h2>
    </div>

    <form method="get" class="filter-row">
        <label class="field" style="width:200px">
            <span class="field-label">Week of</span>
            <input class="input" name="WeekOf" hms-date value="@Model.WeekStart.ToString("dd MMM yyyy")" />
        </label>
        <label class="field" style="width:220px">
            <span class="field-label">Unit</span>
            <select class="input" name="OrgUnitId">
                <option value="">All units</option>
                @foreach (var u in Model.Units)
                {
                    <option value="@u.Id" selected="@(Model.OrgUnitId == u.Id)">@u.Name</option>
                }
            </select>
        </label>
        <button type="submit" class="btn">Show</button>
    </form>

    @if (Model.Shifts.Count == 0)
    {
        <div class="empty-state">
            No shifts are defined yet. Add them under <a href="/hr/policies">Policies</a> — a roster
            without shifts cannot tell a night from a morning, and attendance depends on it.
        </div>
    }
    else if (Model.People.Count == 0)
    {
        <div class="empty-state">No employees are assigned to this unit.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                <tr>
                    <th>Employee</th>
                    @foreach (var d in Model.Days)
                    {
                        <th>@d.ToString("ddd dd")</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.People)
                {
                    <tr>
                        <td>@p.Name <span class="card-hint">@p.Code</span></td>
                        @foreach (var d in Model.Days)
                        {
                            <td>
                                <form method="post" asp-page-handler="Assign" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="employeeId" value="@p.Id" />
                                    <input type="hidden" name="onDate" value="@d.ToString("dd MMM yyyy")" />
                                    <select class="input input-sm" name="shiftId"
                                            aria-label="Shift for @p.Name on @d.ToString("dd MMM")"
                                            onchange="this.form.submit()">
                                        <option value="">—</option>
                                        <option value="0" selected="@(Model.ShiftFor(p.Id, d) == "Off")">Off</option>
                                        @foreach (var sh in Model.Shifts)
                                        {
                                            <option value="@sh.Id" selected="@(Model.ShiftFor(p.Id, d) == sh.Code)">@sh.Code</option>
                                        }
                                    </select>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
