<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hms.Registration.Contracts\Hms.Registration.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Hms.Kernel\Hms.Kernel.csproj" />
    <!-- Removed in spec 0035: this referenced Hms.Billing (the implementation, not its contracts),
         which ADR-0003 forbids. ModuleBoundaryTests reads *referenced assemblies*, so Roslyn's
         unused-reference elision hid it — no Registration code used the type, so nothing was
         emitted for the test to see. It would have fired the moment anyone typed "Hms.Billing."
         here. Registration consumes billing through Hms.Billing.Contracts, like everyone else. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
