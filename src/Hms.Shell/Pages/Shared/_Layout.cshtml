@using Hms.Kernel.Entitlements
@using Hms.Kernel.Time
@inject IReadOnlyList<NavItem> NavRegistry
@inject EntitlementProvider Entitlements
@inject BusinessDayCalendar BusinessDay
@inject TimeProvider Clock
@inject OrgIdentity Hospital
@{
    var user = Context.User;
    var isAuthed = user.Identity?.IsAuthenticated == true;
    var perms = user.FindAll(PermissionPolicy.ClaimType).Select(c => c.Value).ToHashSet();
    var nav = isAuthed
        ? NavComposer.Compose(NavRegistry, perms, Entitlements.EnabledModules.ToHashSet())
        : [];
    var displayName = user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? "";
    var roles = string.Join(", ", user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
    var businessDay = BusinessDay.BusinessDayOf(Clock.GetUtcNow());
    var path = Context.Request.Path.Value ?? "/";

    // The crumb/title come from the nav entry the current URL matches — one source, so the
    // heading can never disagree with the sidebar (05 §2).
    var current = nav.SelectMany(g => g.Items)
        .Where(i => path.Equals(i.Url, StringComparison.OrdinalIgnoreCase))
        .Select(i => new { Item = i, Group = nav.First(g => g.Items.Contains(i)) })
        .FirstOrDefault();
    var crumb = (string?)ViewData["Crumb"] ?? current?.Group.Label ?? "Home";
    var title = (string?)ViewData["Title"] ?? current?.Item.Title ?? "Home";
    // The default belongs to the host, not to this file: the HRM SKU is not a hospital, and these
    // two lines appear on every screen it renders (P27, spec 0036).
    var fkeys = (string?)ViewData["FKeys"] ?? Hospital.DefaultShortcuts;
    var toast = TempData["Toast"] as string;
    var toastIcon = TempData["ToastIcon"] as string ?? "task_alt";
    // The input gate's refusal (spec 0039 WP1.1): rendered here so every screen shows the
    // sentence without each page wiring its own banner for binder-level failures.
    var gateError = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — @Hospital.Name</title>
    <link rel="stylesheet" href="/_content/Hms.Shell/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/Hms.Shell/css/app.css" asp-append-version="true" />
    @if (Hospital.LogoMark is { } favicon)
    {
        <link rel="icon" type="image/png" href="@favicon" asp-append-version="true" />
    }
</head>
<body>
<div class="shell">
    @if (isAuthed)
    {
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">
                    @if (Hospital.LogoMark is { } mark)
                    {
                        <img src="@mark" alt="" asp-append-version="true" />
                    }
                    else
                    {
                        @Hospital.Monogram
                    }
                </span>
                <span class="brand-text">
                    <span class="brand-name">@Hospital.Name</span>
                    <span class="brand-tagline">@Hospital.Tagline</span>
                </span>
            </div>
            <nav class="rail-nav" aria-label="Modules">
                @* Spec 0050: groups fold. The button + items wrapper degrade to a fully
                   expanded rail with JS off; app.js persists per-group state per browser. *@
                @foreach (var group in nav)
                {
                    <div class="nav-group" data-nav-group="@group.Label">
                        <button type="button" class="nav-group-title" data-nav-toggle
                                aria-expanded="true">
                            <span class="dept-dot" data-dept="@group.Module.ToLowerInvariant()"></span>
                            <span>@group.Label</span>
                            <span class="icon nav-caret" aria-hidden="true">chevron_right</span>
                        </button>
                        <div class="nav-group-items">
                            @foreach (var item in group.Items)
                            {
                                var active = path.Equals(item.Url, StringComparison.OrdinalIgnoreCase);
                                <a class="nav-item @(active ? "active" : "")" href="@item.Url"
                                   aria-current="@(active ? "page" : null)">
                                    <span class="icon" aria-hidden="true">@item.Icon</span>
                                    <span>@item.Title</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </nav>
            <div class="rail-foot">@Hospital.ProductName · @Entitlements.EnabledModules.Count module(s) licensed</div>
        </aside>
    }
    <div class="main">
        @if (isAuthed)
        {
            <header class="topbar">
                <div class="topbar-title">
                    <div class="crumb">@crumb</div>
                    <div class="page-title">@title</div>
                </div>
                @if (perms.Contains("registration.read"))
                {
                    <form class="global-search" method="get" action="/registration" role="search">
                        <span class="icon" aria-hidden="true">search</span>
                        <label class="sr-only" for="global-q">Search patients</label>
                        <input id="global-q" name="q" data-global-search
                               placeholder="Search patient by name, ID or phone…" autocomplete="off" />
                    </form>
                }
                @* Gated like the search above it. The HRM SKU ships no Notifications module, so the
                   bell was a 404 in the chrome of every one of its screens (spec 0037). *@
                @if (perms.Contains("notifications.read"))
                {
                    <a class="topbar-btn" href="/notifications/tray" title="Notifications" aria-label="Notifications">
                        <span class="icon icon-lg" aria-hidden="true">notifications</span>
                    </a>
                }
                <div class="user-chip">
                    <span class="avatar">@Ui.Initials(displayName)</span>
                    <span>
                        <span class="user-name">@displayName</span><br />
                        <span class="user-role">@roles</span>
                    </span>
                    <form method="post" action="/logout">
                        @Html.AntiForgeryToken()
                        @* Sign-out remembers the screen, so signing back in returns the operator
                           to the work they were interrupted in (spec 0040). Validated server-side
                           before it is honoured — LoginModel.SafeReturnUrl. *@
                        <input type="hidden" name="returnUrl"
                               value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn-icon" title="Sign out" aria-label="Sign out">
                            <span class="icon icon-sm" aria-hidden="true">logout</span>
                        </button>
                    </form>
                </div>
            </header>
        }
        <main class="content">
            @if (!string.IsNullOrEmpty(gateError))
            {
                <div class="alert bad">
                    <span class="icon icon-sm" aria-hidden="true">error</span>
                    <span>@gateError</span>
                </div>
            }
            @RenderBody()
        </main>
        <footer class="status-footer">
            <span><span class="status-dot"></span> Server: PRIMARY — DB online</span>
            @if (isAuthed)
            {
                <span>User: <b>@displayName</b> — @roles</span>
                <span>Business day: <span class="tabular">@Ui.DateLong(businessDay)</span></span>
                <span class="fkey-map" id="fkey-map">@fkeys</span>
            }
        </footer>
    </div>
</div>

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast" role="status" data-toast>
        <span class="icon" aria-hidden="true">@toastIcon</span>
        <span>@toast</span>
    </div>
}

<script src="/_content/Hms.Shell/js/fkeys.js" asp-append-version="true"></script>
<script src="/_content/Hms.Shell/js/typeahead.js" asp-append-version="true"></script>
<script src="/_content/Hms.Shell/js/hms-date.js" asp-append-version="true"></script>
<script src="/_content/Hms.Shell/js/barcode.js" asp-append-version="true"></script>
<script src="/_content/Hms.Shell/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
