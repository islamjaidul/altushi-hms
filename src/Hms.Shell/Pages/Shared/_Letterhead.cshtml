@model Letterhead
@inject OrgIdentity Hospital
<div class="sheet-head">
    @if (Hospital.LogoMark is { } mark)
    {
        <img class="sheet-logo" src="@mark" alt="" asp-append-version="true" />
    }
    else
    {
        <span class="sheet-mark">@Hospital.Monogram</span>
    }
    <span>
        <div class="sheet-hospital">@Hospital.Name</div>
        <div class="sheet-contact">@Hospital.Address · @Hospital.Phone</div>
    </span>
    <span class="sheet-doc">
        <div class="sheet-doc-title">@Model.DocTitle</div>
        <div class="sheet-doc-no">@Model.DocNo · @Ui.DateTimeShort(Model.At)</div>
    </span>
</div>
