@page "/login"
@model Hms.Shell.Pages.LoginModel
@inject OrgIdentity Hospital
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — @Hospital.Name</title>
    <link rel="stylesheet" href="/_content/Hms.Shell/css/tokens.css" />
    <link rel="stylesheet" href="/_content/Hms.Shell/css/app.css" />
</head>
<body>
<div class="login-wrap">
    <form method="post" class="login-card">
        <div class="login-brand">
            <span class="brand-mark">@Hospital.Monogram</span>
            <span>
                <h1>@Hospital.Name</h1>
                <div class="user-role">@Hospital.Tagline</div>
            </span>
        </div>

        @if (Model.Failed)
        {
            <div class="alert bad">
                <span class="icon icon-sm" aria-hidden="true">error</span>
                <span>Sign-in failed — check the username and password.</span>
            </div>
        }
        @if (Model.LockedOut)
        {
            <div class="alert warn">
                <span class="icon icon-sm" aria-hidden="true">lock</span>
                <span>Account locked after repeated failures — try again in a few minutes.</span>
            </div>
        }

        <label class="field">
            <span class="field-label">Username</span>
            <input class="input" asp-for="Username" autofocus autocomplete="username" />
        </label>
        <label class="field">
            <span class="field-label">Password</span>
            <input class="input" asp-for="Password" type="password" autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-block btn-cta">
            <span class="icon icon-sm" aria-hidden="true">lock</span> Sign in
        </button>
    </form>
</div>
</body>
</html>
