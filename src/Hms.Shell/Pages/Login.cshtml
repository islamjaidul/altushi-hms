@page "/login"
@model Hms.Shell.Pages.LoginModel
@using Hms.Shell.Pages
@inject OrgIdentity Org
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — @Org.Name</title>
    @* asp-append-version stamps a content hash, so a shipped CSS fix actually reaches a browser
       that has the old file cached. Without it a UI change is invisible until a hard refresh. *@
    <link rel="stylesheet" href="/_content/Hms.Shell/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/Hms.Shell/css/app.css" asp-append-version="true" />
    @if (Org.LogoMark is { } favicon)
    {
        <link rel="icon" type="image/png" href="@favicon" asp-append-version="true" />
    }
</head>
<body>
<div class="login-wrap">
    <div class="login-shell">
        <aside class="login-aside">
            @if (Org.LogoLockup is { } lockup)
            {
                <img class="login-logo" src="@lockup" alt="@Org.Name" asp-append-version="true" />
            }
            else
            {
                <span class="brand-mark">@Org.Monogram</span>
            }
            <h1>@Org.Name</h1>
            <div class="tagline">@Org.Tagline</div>
            <div class="rule"></div>
            <div class="aside-note">Use the account your administrator issued you.</div>
        </aside>

        @* novalidate: the browser's own bubble refuses to submit the form, which meant neither
           tier of OUR validation was ever reached — the operator got the browser's wording, in
           the browser's language, gone by the next keystroke (spec 0040). The inputs keep
           `required` for the accessibility semantics; only the browser's UI is suppressed. *@
        <form method="post" class="login-card" novalidate
              data-login-form
              data-msg-username="@LoginModel.UsernameRequired"
              data-msg-password="@LoginModel.PasswordRequired">
            <h2>Sign in</h2>
            <p class="sub">Enter your username and password to continue.</p>

            @if (Model.Failed)
            {
                <div class="alert bad">
                    <span class="icon icon-sm" aria-hidden="true">error</span>
                    <span>Sign-in failed — check the username and password.</span>
                </div>
            }
            @if (Model.LockedOut)
            {
                <div class="alert warn">
                    <span class="icon icon-sm" aria-hidden="true">lock</span>
                    <span>Account locked after repeated failures — try again in a few minutes.</span>
                </div>
            }

            @* Each error element is always in the DOM — empty and hidden when there is nothing
               to say — so the script and the server fill the SAME element. aria-live means it
               is announced when it appears, not merely drawn. *@
            <label class="field">
                <span class="field-label">Username <span class="req">*</span></span>
                <input class="input @(Model.UsernameError is null ? null : "input-invalid")"
                       asp-for="Username" required maxlength="64" autocomplete="username"
                       aria-describedby="username-error"
                       aria-invalid="@(Model.UsernameError is null ? "false" : "true")"
                       autofocus="@(Model.FocusPassword ? null : "autofocus")" />
                <div class="help-text bad" id="username-error" data-error-for="Username"
                     role="alert" aria-live="polite"
                     hidden="@(Model.UsernameError is null ? "hidden" : null)">@Model.UsernameError</div>
            </label>
            <label class="field">
                <span class="field-label">Password <span class="req">*</span></span>
                @* Deliberately no maxlength: capping it here would silently truncate a longer
                   existing password and turn a correct credential into a failed sign-in. *@
                <input class="input @(Model.PasswordError is null ? null : "input-invalid")"
                       asp-for="Password" type="password" required autocomplete="current-password"
                       aria-describedby="password-error"
                       aria-invalid="@(Model.PasswordError is null ? "false" : "true")"
                       autofocus="@(Model.FocusPassword ? "autofocus" : null)" />
                <div class="help-text bad" id="password-error" data-error-for="Password"
                     role="alert" aria-live="polite"
                     hidden="@(Model.PasswordError is null ? "hidden" : null)">@Model.PasswordError</div>
            </label>
            <button type="submit" class="btn btn-primary btn-block btn-cta">
                <span class="icon icon-sm" aria-hidden="true">lock</span> Sign in
            </button>
        </form>
    </div>
</div>
@* Local and vendored — no CDN (§8 N2: the product must render with the network unplugged).
   Progressive enhancement only: with scripting off the form posts and the server refuses it
   with the same words, which is what keeps this page honest. *@
<script src="/_content/Hms.Shell/js/login.js" asp-append-version="true"></script>
</body>
</html>
